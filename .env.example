# All settings have sensible defaults (see app/config.py) -- you don't
# need to fill anything in to run the app. This file documents what's
# tunable.

# --- Ollama (LLM) ---
# Defaults assume Ollama is running locally after `ollama pull qwen2.5:7b`.
# If Ollama isn't running, the app automatically falls back to extractive
# (non-generative) answers -- no crash, just lower answer quality.
OLLAMA_BASE_URL=http://localhost:11434
# Must match a name from `ollama list` exactly (e.g. qwen2.5:7b-instruct).
# On 8GB machines the 3b model is the practical choice.
OLLAMA_MODEL=qwen2.5:7b

# --- Embeddings / reranker ---
# BAAI/bge-small-en-v1.5 downloads automatically from Hugging Face on
# first run (~130MB). If that download can't complete, the app falls
# back to local TF-IDF embeddings automatically.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_ENABLED=true

# --- Chunking / retrieval ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8
RERANK_TOP_K=3

# --- Voice (ElevenLabs) ---
# Optional. Leave the key empty and the app runs text-only.
# Never commit a real key: .env is in .gitignore.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v2
VOICE_MAX_CHARS=400

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit -> FastAPI ---
API_BASE_URL=http://localhost:8000
